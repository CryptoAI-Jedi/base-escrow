# --- Chain / Network ---
NETWORK_NAME=base-sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# --- EscrowMarket contract (Base Sepolia) ---
ESCROW_MARKET_ADDRESS=0xREPLACE_WITH_ESCROW_MARKET_ADDRESS

# --- Ponder indexer (escrow discovery; chain reads stay authoritative) ---
PONDER_GRAPHQL_URL=http://127.0.0.1:42069/graphql

# --- IPFS gateway for evidence fetches ---
IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# --- Resolver service (called by CRE) ---
RESOLVER_BASE_URL=http://127.0.0.1:8080
RESOLVER_API_TOKEN=REPLACE_WITH_RANDOM_HEX_TOKEN

# --- Dev-only submission harness (CRE owns production submission) ---
RESOLVER_SUBMIT_ENABLED=false
RESOLVER_SIGNER_PRIVATE_KEY=0xREPLACE_WITH_PRIVATE_KEY
RESOLVER_SIGNER_ADDRESS=0xREPLACE_WITH_SIGNER_ADDRESS

# --- AI assessor (optional — resolver works without it) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_API_KEY

# --- Optional ---
POLL_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
